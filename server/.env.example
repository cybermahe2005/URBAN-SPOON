PORT=5000

# MongoDB Atlas Connection String (Recommended for Production & Deployment)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/urban_spoon?retryWrites=true&w=majority&appName=UrbanSpoon
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/urban_spoon?retryWrites=true&w=majority&appName=UrbanSpoon

# For local MongoDB development instead of Atlas, use:
# MONGO_URI=mongodb://localhost:27017/urban_spoon

JWT_SECRET=replace_with_a_long_random_production_secret_key
JWT_EXPIRE=7d

# Frontend URL(s) allowed by CORS (comma-separated for multiple domains, no trailing slash)
CLIENT_URL=http://localhost:5173

NODE_ENV=development
